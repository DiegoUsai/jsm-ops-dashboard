# Jira Service Management
JIRA_BASE_URL=https://your-instance.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_WEBHOOK_SECRET=your-webhook-hmac-secret
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY

# Database (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Pseudonymization
HMAC_SECRET=your-hmac-secret-for-pseudonymization

# MS Teams Alert
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# SLA Thresholds (milliseconds)
SLA_WARNING_THRESHOLD_MS=7200000
SLA_CRITICAL_THRESHOLD_MS=3600000

# VIP first response threshold (milliseconds) — default 1h
VIP_FIRST_RESPONSE_MS=3600000

# Vercel Cron Secret
CRON_SECRET=your-cron-secret

# Auth (Google OAuth2)
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_EMAILS=user1@example.com,user2@example.com
