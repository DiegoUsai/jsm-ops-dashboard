# Jira Service Management
JIRA_BASE_URL=https://simaggioli.atlassian.net
JIRA_EMAIL=service-account@simaggioli.it
JIRA_API_TOKEN=your-api-token
JIRA_WEBHOOK_SECRET=your-webhook-hmac-secret
JIRA_PROJECT_KEY=SD

# Database (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Pseudonymization
HMAC_SECRET=your-hmac-secret-for-pseudonymization

# MS Teams Alert
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# SLA Thresholds (milliseconds)
SLA_WARNING_THRESHOLD_MS=7200000
SLA_CRITICAL_THRESHOLD_MS=3600000

# VIP first response threshold (milliseconds) — default 1h
VIP_FIRST_RESPONSE_MS=3600000

# Vercel Cron Secret
CRON_SECRET=your-cron-secret
